+	err = xe_tlb_inval_ggtt_vf(&ggtt->tile->primary_gt->tlb_inval, trace);
+	if (!err && ggtt->tile->media_gt)
+		err = xe_tlb_inval_ggtt_vf(&ggtt->tile->media_gt->tlb_inval, trace);
+	return err;
+}
